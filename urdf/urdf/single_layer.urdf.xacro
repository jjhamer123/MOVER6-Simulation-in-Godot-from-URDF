<?xml version="1.0"?>
<!--
  ELE408 Robot Art - ONE LAYER, matching RobotArtLayer_assembly.step part for part (v3).
  Links (STEP component in brackets):
    bar_above    [Bar200_above]      fixed to the world, where the STEP file has it
    clampA       [ClampA_link]       clamp A + 608 bearing                      joint clampA  : fixed
    motor        [Motor_link]        carriage + cage + pin + encoder + NEMA 17  joint pivot   : continuous, TOP PIVOT (passive bearing)
    support_bar  [Support500_link]   500 mm bar + ball units                    joint support : prismatic along X (passive slide)
    hub          [Hub_link]          flange coupler + clamp B / drive hub       joint joint   : continuous, BOTTOM PIVOT, driven
    next_bar     [NextBar200_reference]                                         joint clampB  : prismatic, radius 0.03-0.17 m
    track_L / track_R [Tracks_frame_reference]   U-channel tracks fixed to the world
  With the bar above fixed, pivot and support both stay at 0 (the motor doesn't move).
  Units m, kg, rad. Meshes are in mm and scaled by 0.001.
  Radius = rest_radius + clampB value (rest_radius is 0 for ROS, 0.07 for the Godot files).
  Build:  xacro single_layer.urdf.xacro > single_layer.urdf
-->
<robot name="robot_art_single_layer" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="rest_radius" default="0.0"/>  <!-- Godot: 0.07 so the URDF zero pose is a real radius -->
  <xacro:arg name="mesh_path" default="package://robot_art_layer/meshes/"/>
  <xacro:property name="M" value="$(arg mesh_path)"/>
  <xacro:property name="R0" value="$(arg rest_radius)"/>
  <xacro:include filename="robot_art_parts.xacro"/>
  <!-- same place as in the STEP file: pivot axis at x 499.35, y 26.33 mm; bar centre line at z 81.36 mm -->
  <xacro:property name="ax" value="0.49935"/>
  <xacro:property name="ay" value="0.02633"/>
  <xacro:property name="az" value="0.08136"/>

  <link name="world"/>
  <joint name="bar_above_fixed" type="fixed">
    <parent link="world"/><child link="bar_above"/><origin xyz="${ax} ${ay} ${az}"/>
  </joint>
  <xacro:bar_link name="bar_above"/>

  <joint name="clampA" type="fixed">
    <parent link="bar_above"/><child link="clampA"/><origin xyz="0 0 0"/>
  </joint>
  <xacro:clampA_link name="clampA"/>

  <!-- TOP PIVOT: 608 bearing, 23.7 mm below the bar centre line (passive) -->
  <joint name="pivot" type="continuous">
    <parent link="clampA"/><child link="motor"/><origin xyz="0 0 ${pivot_z}"/>
    <axis xyz="0 0 1"/><limit effort="0" velocity="10"/><dynamics friction="0.002" damping="0.0"/>
  </joint>
  <xacro:motor_link name="motor"/>
  <xacro:support_link name="support" parent="motor"/>
  <joint name="encoder_mount" type="fixed">
    <parent link="motor"/><child link="encoder"/><origin xyz="0 0 -0.0479"/>
  </joint>
  <link name="encoder"><inertial><mass value="0.001"/><inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/></inertial></link>

  <!-- BOTTOM PIVOT: motor front face, 75.9 mm below the top pivot, driven by the NEMA 17 -->
  <joint name="joint" type="continuous">
    <parent link="motor"/><child link="hub"/><origin xyz="0 0 ${motor_z}"/><axis xyz="0 0 1"/>
    <limit effort="${motor_torque}" velocity="${max_speed}"/><dynamics damping="0.0"/>
  </joint>
  <link name="hub">
    <visual><geometry><mesh filename="${M}hub.stl" scale="${S}"/></geometry><material name="orange"/></visual>
    <collision><origin xyz="0 0 -0.0135"/><geometry><cylinder radius="0.011" length="0.018"/></geometry></collision>
    <collision><origin xyz="0 0 ${clampB_z}"/><geometry><box size="0.040 0.028 0.0284"/></geometry></collision>
    <inertial><origin xyz="-0.00000 0.00004 -0.02232"/><mass value="0.0208"/><inertia ixx="5.9366e-06" ixy="3.9488e-16" ixz="-1.5550e-12" iyy="6.2704e-06" iyz="1.3147e-08" izz="2.9028e-06"/></inertial>
  </link>

  <!-- CLAMP B: the next 200 mm bar slides through it along X; value = radius (STEP file shows 0.07) -->
  <joint name="clampB" type="prismatic">
    <parent link="hub"/><child link="next_bar"/>
    <origin xyz="${R0} 0 ${clampB_z}" rpy="0 0 ${pi/2}"/><axis xyz="0 -1 0"/>
    <limit lower="${r_min - R0}" upper="${r_max - R0}" effort="20" velocity="0.05"/><dynamics damping="0.5"/>
  </joint>
  <xacro:bar_link name="next_bar"/>

  <!-- tracks as in the STEP file (200 mm sections) -->
  <xacro:track name="track_L" x="${ax - track_x}" y="${ay}" z="${az + pivot_z + track_floor}" length="0.2"/>
  <xacro:track name="track_R" x="${ax + track_x}" y="${ay}" z="${az + pivot_z + track_floor}" length="0.2"/>
</robot>
