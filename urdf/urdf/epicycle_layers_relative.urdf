  <!-- the next bar slides through clamp B; at joint = 0 the arm points along +X (rpy turns the bar mesh 90 deg) -->
  <joint name="clampB3" type="prismatic">
    <parent link="hub3"/>
    <child link="bar3"/>
    <origin rpy="0 0 1.5707963267948966" xyz="0.0 0 -0.0367"/>
    <axis xyz="0 -1 0"/>
    <limit effort="20" lower="0.03" upper="0.17" velocity="0.05"/>
    <dynamics damping="0.5"/>
